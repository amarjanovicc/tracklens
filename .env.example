# --- Core ---
DATABASE_URL=postgres://localhost:5432/tracklens
BETTER_AUTH_SECRET=change-me-32-bytes-hex
BETTER_AUTH_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# --- Spotify (https://developer.spotify.com/dashboard) ---
# Redirect URI to register: http://127.0.0.1:3000/api/spotify/callback
# (Spotify no longer accepts "localhost" redirect URIs; use 127.0.0.1)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Cron (Vercel Cron sends "Authorization: Bearer $CRON_SECRET") ---
CRON_SECRET=change-me

# --- Stripe (optional; billing UI is disabled when unset) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
